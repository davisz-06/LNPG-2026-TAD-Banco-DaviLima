# TAREFA 3: IMPLEMENTAÇÃO DO TAD CONTABANCARIA
# ==============================================================================

class ContaBancaria:
    """
    Representa o Tipo Abstrato de Dados (TAD) ContaBancaria.
    Demonstra COMPOSIÇÃO/AGREGAÇÃO ao exigir um Cliente (titular) e um Banco.
    """
    
    def __init__(self, numero, titular, banco, saldoInicial):
        """Operação: Cria uma nova conta bancária."""
        # Validação do Número da Conta (Maior que zero)
        if numero > 0:
            self.__numero = numero
        else:
            raise ValueError("O número da conta deve ser maior que zero.")
            
        # Validação do Titular (Não pode ser nulo e deve ser um Cliente válido)
        if titular is not None and isinstance(titular, Cliente) and titular.getNome() is not None:
            self.__titular = titular
        else:
            raise ValueError("Toda conta deve possuir exatamente um titular válido associado.")
            
        # Validação do Banco (Não pode ser nulo e deve ser uma instância de Banco)
        if banco is not None and isinstance(banco, Banco) and banco.getNome() is not None:
            self.__banco = banco
        else:
            raise ValueError("Toda conta deve estar associada a exatamente um banco válido.")
            
        # Regra do Saldo Inicial: Se negativo, inicia com zero
        if saldoInicial >= 0:
            self.__saldo = float(saldoInicial)
        else:
            self.__saldo = 0.0

    # Métodos de Acesso (Getters)
    def getNumero(self):
        return self.__numero

    def getTitular(self):
        return self.__titular

    def getBanco(self):
        return self.__banco

    def consultarSaldo(self):
        """Consulta de saldo: não modifica nenhuma informação da conta."""
        return self.__saldo

    # Regras de Negócio e Operações Financeiras
    def depositar(self, valor):
        """Somente valores positivos podem ser adicionados ao saldo."""
        if valor > 0:
            self.__saldo += valor
            print(f"[DEPÓSITO] R$ {valor:.2f} depositados na conta {self.__numero}.")
        else:
            print(f"[ERRO DE DEPÓSITO] Valor R$ {valor:.2f} inválido para depósito na conta {self.__numero}.")

    def sacar(self, valor):
        """
        Somente valores positivos podem ser retirados.
        Um saque só é realizado se existir saldo suficiente.
        """
        if valor <= 0:
            print(f"[ERRO DE SAQUE] Valor R$ {valor:.2f} inválido para saque na conta {self.__numero}.")
            return False
            
        if self.__saldo >= valor:
            self.__saldo -= valor
            print(f"[SAQUE] R$ {valor:.2f} retirados da conta {self.__numero}.")
            return True
        else:
            print(f"[ERRO DE SAQUE] Saldo insuficiente na conta {self.__numero} para sacar R$ {valor:.2f}.")
            return False

    def estaAtiva(self):
        """Uma conta é ativa quando seu saldo é estritamente maior que zero."""
        return self.__saldo > 0


