class Banco:
    """
    Representa o Tipo Abstrato de Dados (TAD) Banco.
    Gerencia uma coleção de contas bancárias (Relacionamento de Agregação).
    """
    
    def __init__(self, nome, codigo):
        """Operação: Cria um banco sem contas cadastradas."""
        self.__nome = None
        self.__codigo = None
        # Coleção de contas inicializada como uma lista vazia
        self.__contas = []
        
        # Validação do Nome do Banco (Mínimo 3 caracteres)
        if nome is not None and len(nome.strip()) >= 3:
            self.__nome = nome.strip()
        else:
            print("[ERRO] Nome do banco inválido (mínimo 3 caracteres).")
            
        # Validação do Código do Banco (Maior que zero)
        if codigo > 0:
            self.__codigo = codigo
        else:
            print("[ERRO] Código do banco deve ser maior que zero.")

    # Métodos de Acesso (Getters)
    def getNome(self):
        return self.__nome

    def getCodigo(self):
        return self.__codigo

    # Operações de Gerenciamento de Contas
    def buscarConta(self, numero):
        """
        Localiza uma conta pelo número.
        Retorna o objeto ContaBancaria se achar, ou None se não encontrar.
        """
        for conta in self.__contas:
            if conta.getNumero() == numero:
                return conta
        return None

    def adicionarConta(self, conta):
        """
        Adiciona uma conta ao banco respeitando as regras:
        - Não podem existir duas contas com o mesmo número no mesmo banco.
        - Uma conta só pode pertencer a um banco por vez.
        """
        if conta is None:
            return False
            
        # Verifica se já existe conta com esse número no banco
        if self.buscarConta(conta.getNumero()) is not None:
            print(f"[ERRO] Já existe a conta {conta.getNumero()} neste banco.")
            return False
            
        # Verifica se a conta está associada a este banco especificamente
        if conta.getBanco() != self:
            print(f"[ERRO] A conta {conta.getNumero()} não está associada a este banco institucionalmente.")
            return False
            
        # Adiciona na lista/coleção privada
        self.__contas.append(conta)
        return True

    def removerConta(self, numero):
        """Remove uma conta do banco através do número."""
        conta = self.buscarConta(numero)
        if conta is not None:
            self.__contas.remove(conta)
            return True
        print(f"[ERRO] Conta {numero} não encontrada para remoção.")
        return False

    def quantidadeContas(self):
        """Retorna a quantidade de contas cadastradas."""
        return len(self.__contas)

    def listarContas(self):
        """Retorna todas as contas cadastradas (a coleção)."""
        return self.__contas


