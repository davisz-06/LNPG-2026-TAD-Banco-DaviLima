# ==============================================================================
# TAREFA 4: SUBPROGRAMAS DE VALIDAÇÃO (Reutilizáveis e Auxiliares)
# ==============================================================================

def limpar_apenas_numeros(texto):
    """
    Subprograma auxiliar que remove qualquer caractere que não seja número.
    Útil para tratar CPFs com pontos/hífen e telefones com parênteses/espaços.
    """
    if not texto:
        return ""
    # Retorna apenas os caracteres que são dígitos (0-9)
    return "".join(caractere for caractere in str(texto) if caractere.isdigit())


def validar_nome_cliente(nome):
    """
    Regra de Negócio do Cliente: Nome não pode ser nulo/vazio e deve ter >= 5 caracteres.
    """
    if nome is None:
        return False
    # strip() remove espaços em branco inúteis no começo e no fim
    if len(nome.strip()) < 5:
        return False
    return True


def validar_cpf(cpf):
    """
    Regra de Negócio do Cliente: CPF não nulo e deve conter exatamente 11 dígitos numéricos.
    """
    if cpf is None:
        return False
    cpf_limpo = limpar_apenas_numeros(cpf)
    return len(cpf_limpo) == 11


def validar_telefone(telefone):
    """
    Regra de Negócio do Cliente: Opcional. Se informado, de 10 a 11 dígitos numéricos.
    """
    # Se for vazio, nulo ou string vazia, é válido pois é opcional
    if telefone is None or str(telefone).strip() == "":
        return True
    tel_limpo = limpar_apenas_numeros(telefone)
    return len(tel_limpo) in [10, 11]


def validar_email(email):
    """
    Regra de Negócio do Cliente: Opcional. Se informado, deve conter '@'.
    """
    if email is None or str(email).strip() == "":
        return True
    return "@" in str(email)


# ==============================================================================
# TAREFA 1: IMPLEMENTAÇÃO DO TAD CLIENTE
# ==============================================================================

class Cliente:
    """
    Representa o Tipo Abstrato de Dados (TAD) Cliente.
    Utiliza encapsulamento para garantir que dados inválidos não sejam armazenados.
    """
    
    def __init__(self, nome, cpf, telefone=None, email=None):
        """
        Operações: Construtores (Em Python, usamos parâmetros opcionais/padrão para simular a sobrecarga).
        Suporta tanto Cliente(nome, cpf) quanto Cliente(nome, cpf, telefone, email).
        """
        # Inicializa os atributos privados (com __) como None por padrão
        self.__nome = None
        self.__cpf = None
        self.__telefone = None
        self.__email = None
        
        # Aplicação das Regras de Negócio na inicialização usando os subprogramas
        if validar_nome_cliente(nome):
            self.__nome = nome.strip()
        else:
            print(f"[ERRO] Nome '{nome}' inválido! O cliente não será armazenado corretamente.")
            
        if validar_cpf(cpf):
            self.__cpf = limpar_apenas_numeros(cpf)
        else:
            print(f"[ERRO] CPF '{cpf}' inválido! O cliente não será armazenado corretamente.")
            
        if validar_telefone(telefone):
            self.__telefone = limpar_apenas_numeros(telefone) if telefone else None
        else:
            print(f"[ERRO] Telefone '{telefone}' inválido! Não foi armazenado.")
            
        if validar_email(email):
            self.__email = email
        else:
            print(f"[ERRO] E-mail '{email}' inválido! Não foi armazenado.")

    # Métodos de Acesso (Getters) para garantir o encapsulamento
    def getNome(self):
        """Retorna o nome do cliente."""
        return self.__nome

    def getCpf(self):
        """Retorna o CPF do cliente."""
        return self.__cpf

    def getTelefone(self):
        """Retorna o telefone do cliente."""
        return self.__telefone

    def getEmail(self):
        """Retorna o e-mail do cliente."""
        return self.__email

    # Métodos de Modificação (Setters/Operações de alteração) com validação
    def alterarTelefone(self, telefone):
        """Atualiza o telefone do cliente caso seja válido."""
        if validar_telefone(telefone):
            self.__telefone = limpar_apenas_numeros(telefone) if telefone else None
            return True
        print(f"[ERRO] Falha ao alterar: Telefone '{telefone}' inválido.")
        return False

    def alterarEmail(self, email):
        """Atualiza o e-mail do cliente caso seja válido."""
        if validar_email(email):
            self.__email = email
            return True
        print(f"[ERRO] Falha ao alterar: E-mail '{email}' inválido.")
        return False


